# Node.js 24+. Generate separate secrets with: openssl rand -hex 32
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/gateway.db
REAL_KEY_1=
# REAL_KEY_2=
# REAL_KEY_3=
ADMIN_ID=admin
ADMIN_SECRET=
JWT_SECRET=

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=
CLAUDE_FALLBACKS=
CLAUDE_TIMEOUT_MS=600000
DEFAULT_SYSTEM_PROMPT=
MAX_PROMPT_CHARS=50000

# Optional OpenAI integration. Fill 1–5 keys; leave unused slots empty.
# Restart the server after changing keys. Never renumber slots used in reports.
OPENAI_KEY_1=
OPENAI_KEY_2=
OPENAI_KEY_3=
OPENAI_KEY_4=
OPENAI_KEY_5=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_MS=60000
# OPENAI_BASE_URL=https://api.openai.com/v1

# Combined Claude + OpenAI per-client limits; empty means unlimited.
DEFAULT_MONTHLY_BUDGET_USD=
DEFAULT_REQUESTS_PER_MINUTE=
# Clients must reuse their token until expiry; earlier login returns 409.
TOKEN_TTL_MINUTES=60
ADMIN_TOTP_SECRET=
ADMIN_TOKEN_TTL_MINUTES=15
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
ALLOWED_ORIGINS=
TRUST_PROXY=false
